# Copy this file to the repository root as .env and replace every placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose PostgreSQL is exposed on host port 5433.
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgres://event_app:replace-with-a-local-database-password@127.0.0.1:5433/event_registration

REDIS_URL=redis://127.0.0.1:6379/0
TICKET_HOLD_DURATION_SECONDS=600

# Use Paystack test keys locally. Never commit a real key.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Development email backend prints messages to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.test
